{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-web.local/schemas/skill.schema.json",
  "title": "Claude Web Skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "destructive",
    "input",
    "permissions",
    "pathFields"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "destructive": {
      "type": "boolean"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "filesystem.delete",
          "process.read",
          "process.execute",
          "system.read"
        ]
      }
    },
    "pathFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
